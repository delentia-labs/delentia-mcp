{
  "version": "1.0.0",
  "organization_id": "local",
  "policy_id": "delentia-guard-coding-agent-v1",
  "policy_name": "Coding agent starter policy (filesystem / git / GitHub / shell MCP servers)",
  "default_fallback_A": 0,
  "custom_safety_threshold": 0.5,
  "rules": [
    {
      "rule_id": "READ-ALLOW",
      "description": "Reading, listing and searching are allowed.",
      "intent_patterns": ["read_*", "list_*", "get_*", "search_*", "find_*", "query_*", "directory_tree", "*_info", "*_status", "*_diff", "*_log", "*_show", "fetch", "fetch_*"],
      "action_type": "ALLOW",
      "assigned_A": 1
    },
    {
      "rule_id": "WRITE-NO-SECRETS",
      "description": "Writes are allowed except to secrets, keys, git internals and system paths.",
      "intent_patterns": ["write_*", "edit_*", "create_*", "update_*", "move_*", "rename_*", "save_*", "apply_*", "push_files", "create_or_update_file", "git_add", "git_commit"],
      "action_type": "CONDITIONAL",
      "assigned_A": 1,
      "denied_paths": [".env", ".git/", "id_rsa", "id_ed25519", ".ssh/", ".pem", ".key", "credentials", "secrets", "/etc/", "c:/windows/"]
    },
    {
      "rule_id": "DESTRUCTIVE-BLOCK",
      "description": "Deleting, dropping, force-pushing, merging and resetting need a human.",
      "intent_patterns": ["delete_*", "*_delete", "remove_*", "drop_*", "truncate_*", "purge_*", "force_*", "reset_*", "git_reset", "git_push", "merge_*", "close_*"],
      "action_type": "REQUIRE_HUMAN_SIGNATURE",
      "assigned_A": 0,
      "require_human_confirmation": true
    },
    {
      "rule_id": "SHELL-BLOCK",
      "description": "Arbitrary command execution needs a human.",
      "intent_patterns": ["run_command", "run_*", "execute_*", "exec_*", "shell*", "bash*", "terminal*", "*_exec", "eval_*"],
      "action_type": "REQUIRE_HUMAN_SIGNATURE",
      "assigned_A": 0,
      "require_human_confirmation": true
    }
  ]
}
