{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delentia-fdia-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "FDIA_SESSION_DO",
        "class_name": "FDIASessionDO"
      },
      {
        "name": "MEE_SESSION_DO",
        "class_name": "MEEGrowthSessionDO"
      },
      {
        "name": "MEE_GATED_DO",
        "class_name": "MEEGrowthGatedDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FDIASessionDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["MEEGrowthSessionDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MEEGrowthGatedDO"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SERVER_NAME": "Delentia FDIA Security MCP"
    // Round 32 (prep only, not wired live): once a real, publicly-
    // reachable Delentia-OS Python kernel API exists (see
    // Delentia-OS/DEPLOYMENT.md), add:
    // "PYTHON_KERNEL_URL": "https://<your-real-host>"
    // Round 48: the kernel API rejects proxied/tunneled requests without
    // its DELENTIA_API_TOKEN, so also store the same value as a Worker
    // secret (never here): `npx wrangler secret put PYTHON_KERNEL_TOKEN`.
    // Then run `npx wrangler deploy` to activate pythonKernelBridge.ts's
    // cross-check in the real evaluate_fdia handler.
  }
}
