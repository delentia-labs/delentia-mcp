{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delentia-sovereign-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "MEE_SESSION_DO",
        "class_name": "MEEGrowthSessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MEEGrowthSessionDO"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SERVER_NAME": "Delentia Sovereign AI Ecosystem All-in-One MCP",
    "FDIA_ARCHITECT_KEYS_JSON": "[{\"key_id\":\"architect-1\",\"role\":\"Chief_Architect\",\"public_key_hex\":\"803ae137d31b64cdaa181ae54f2a914fbc27e96c66dafdc342f6b47af3c89567\"}]"
    // Round 48: Architect tokens (the A in FDIA) are Ed25519 signatures now.
    // Until this var lists trusted approver public keys, NO architect_token is
    // accepted and every REQUIRE_HUMAN_SIGNATURE action stays blocked
    // (fail-closed). Public keys, so a var is fine. Generate an entry with
    // `node scripts/sign-architect-token.mjs --public-key <pem> --key-id <id> --role Chief_Architect`:
    // "FDIA_ARCHITECT_KEYS_JSON": "[{\"key_id\":\"chief-1\",\"role\":\"Chief_Architect\",\"public_key_hex\":\"<64 hex>\"}]"
    // ZUPLO_SHARED_SECRET is a Worker secret now: `npx wrangler secret put ZUPLO_SHARED_SECRET`
    // (it used to be a plain var here, i.e. committed to git).
  }
}
