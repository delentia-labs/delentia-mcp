{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delentia-intent-loop-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "RCTDB_LOG_DO",
        "class_name": "RCTDBLogSessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RCTDBLogSessionDO"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SERVER_NAME": "Delentia Intent Loop MCP"
    // GRAPHRAG_BASE_URL, VECTOR_SEARCH_BASE_URL, VECTOR_SEARCH_DIMENSION
    // and HALTING_DETECTION_BASE_URL are all deliberately left unset here:
    // none of <private>/microservices/{graphrag-complete,vector-search,
    // halting-detection} has a public deployment as of 2026-09-13, so
    // there is no real URL to commit yet for any of them. Set the
    // relevant *_BASE_URL to a reachable instance's base URL (e.g. a
    // Cloudflare Tunnel to a local dev instance, or a real deployed URL
    // once one exists) to turn on that specific bridge
    // (syncToGraphRag()/syncToVectorSearch()/checkGeneratedCodeHalts() in
    // worker.ts) — each stays the silent no-op it already defaults to
    // without its own var, independently of the others.
  }
  // OPENROUTER_API_KEY is a secret, set via `wrangler secret put OPENROUTER_API_KEY`
  // at deploy time — never committed here. Not deployed yet as of 2026-09-12;
  // this config exists so `npm run build`/`typecheck` cover this package like
  // every other pillar worker, deploy is a separate, explicitly-gated step.
}
